@page
@model IndexModel
@{
    ViewData["Title"] = "Análisis de textos";
}

<section class="instance version-@Model.Info.Version">
    <div>
        <span class="label">Versión</span>
        <strong>@Model.Info.Version</strong>
    </div>
    <div>
        <span class="label">Revisión</span>
        <code>@Model.Info.Revision</code>
    </div>
    <div>
        <span class="label">Réplica web</span>
        <code>@Model.Info.Replica</code>
    </div>
    <div>
        <span class="label">Réplica api</span>
        <code id="api-replica">—</code>
    </div>
</section>

<div class="grid">
    <form id="create-form" class="card">
        <h2>Analizar un texto</h2>
        <p class="hint">La web lo envía a la API, la API lo guarda en Cosmos DB y lo pone en la cola, y un worker lo analiza con Azure AI Language.</p>
        <textarea name="text" rows="4" required placeholder="Ej.: Pedí el producto el lunes y llegó el miércoles. Funciona excelente, aunque el envío fue caro."></textarea>
        <button type="submit">Enviar</button>
    </form>

    <form id="bulk-form" class="card">
        <h2>Generar carga en la cola</h2>
        <p class="hint">Crea muchos trabajos de una vez para ver escalar al worker con KEDA. Cada trabajo usa ~2 registros de la cuota gratis de Azure AI Language (5.000 al mes).</p>
        <input name="count" type="number" min="1" max="200" value="20" required />
        <button type="submit">Generar trabajos</button>
    </form>
</div>

<p id="message" class="message" hidden></p>

<section class="stats">
    <div><span id="stat-total">0</span> total</div>
    <div><span id="stat-pending">0</span> pendientes</div>
    <div><span id="stat-completed">0</span> completados</div>
    <div><span id="stat-workers">0</span> réplicas de worker usadas</div>
</section>

<table>
    <thead>
        <tr>
            <th>Creado</th>
            <th>Texto</th>
            <th>Estado</th>
            <th>Sentimiento</th>
            <th>Resumen</th>
            <th>Motor</th>
            <th>Procesado por</th>
            <th>ms</th>
        </tr>
    </thead>
    <tbody id="jobs"></tbody>
</table>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}
